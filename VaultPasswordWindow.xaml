<Window x:Class="AuthWin.VaultPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AuthWin" Width="390" MinHeight="190" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtInstructions" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="txtError" Foreground="DarkRed" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed" />
        <TextBlock Text="Password" />
        <PasswordBox x:Name="passwordBox" Margin="0,3,0,10" />
        <StackPanel x:Name="pnlConfirmation" Visibility="Collapsed">
            <TextBlock Text="Confirm password" />
            <PasswordBox x:Name="confirmationBox" Margin="0,3,0,10" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="75" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="btnSubmit" Content="Unlock" Width="75" IsDefault="True" Click="Submit_Click" FontWeight="Bold" />
        </StackPanel>
    </StackPanel>
</Window>
